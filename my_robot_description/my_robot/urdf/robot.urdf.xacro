<?xml version="1.0"?>
<robot name="diff_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================ -->
  <!--  Parameters  — edit to match your robot                           -->
  <!-- ================================================================ -->
  <xacro:property name="base_length"      value="0.440"/>
  <xacro:property name="base_width"       value="0.500"/>
  <xacro:property name="base_height"      value="0.10"/>
  <xacro:property name="wheel_radius"     value="0.033"/>
  <xacro:property name="wheel_thickness"  value="0.020"/>
  <xacro:property name="wheel_separation" value="0.290"/>

  <!-- Sensor offsets -->
  <xacro:property name="lidar_height"     value="0.01"/>  <!-- LiDAR body half-height -->
  <xacro:property name="imu_size"         value="0.025"/>  <!-- IMU box side length -->

  <xacro:property name="tof_x_offset"       value="0.185"/>  <!-- forward from base_link (m) -->
  <xacro:property name="tof_y_offset"       value="0.17"/>  <!-- half sensor separation (m) -->
  <xacro:property name="tof_z_offset"       value="0.05"/>  <!-- height above base plate (m) -->
  <xacro:property name="tof_crossover_dist" value="0.40"/>  <!-- desired ray crossover (m) -->
  <!-- toe_in_rad derived from geometry — no need to edit manually -->
  <xacro:property name="tof_toe_in_rad"
    value="${atan2(tof_y_offset, tof_crossover_dist)}"/> 
    
  <!-- ================================================================ -->
  <!--  Links & Joints                                                    -->
  <!-- ================================================================ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0.0825 0 ${wheel_radius + 0.04}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="blue"><color rgba="0.2 0.4 0.8 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name y_reflect">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="-0.0825 ${y_reflect * wheel_separation / 2} -0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left_wheel"  y_reflect=" 1"/>
  <xacro:wheel name="right_wheel" y_reflect="-1"/>

  <!-- Caster -->
  <xacro:macro name="caster_wheel" params="name y_reflect">
    <link name="${name}">
      <visual>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="0.100 ${y_reflect * 0.1375} -0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster_wheel name="left_caster_wheel"  y_reflect=" 1"/>
  <xacro:caster_wheel name="right_caster_wheel" y_reflect="-1"/>

  <!-- ================================================================ -->
  <!--  IMU                                                               -->
  <!--  Centered on top of base. Frame aligned with base_link (no rpy). -->
  <!--  Edit xyz to match your physical mounting position.               -->
  <!-- ================================================================ -->
  <link name="imu_link">
    <visual>
      <geometry><box size="${imu_size} ${imu_size} 0.010"/></geometry>
      <material name="green"><color rgba="0.0 0.8 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${imu_size} ${imu_size} 0.010"/></geometry>
    </collision>
    <inertial>
      <mass value="0.010"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <!-- Sits on top of the base, centered -->
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================ -->
  <!--  LiDAR                                                             -->
  <!--  Mounted forward-center on top of base. Adjust xyz as needed.    -->
  <!--  The laser scan plane is at z=0 of lidar_link by convention.     -->
  <!-- ================================================================ -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="${lidar_height * 2}"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="${lidar_height * 2}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.150"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <!-- Forward-center, scan plane level with top of lidar body -->
    <origin xyz="0 0 ${base_height/2 + lidar_height + 0.1}" rpy="0 0 ${pi}"/>
  </joint>

  <!-- Camera link -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.04 0.08 0.03"/>  <!-- rough C270 dimensions -->
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Joint connecting camera to your base (adjust xyz rpy to match real mount) -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.2 0.0 0.12" rpy="0.0 0.0 0.0"/> <!-- rpy in radians: 0.17 rad ≈ 10° tilt down -->
  </joint>

  <!-- Depth camera base frame (relative to base_link, at the same location as camera_link) -->
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0.2 0.0 0.12" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- Depth camera optical frame (coincident with camera_depth_frame, rotated for standard ROS optical convention: Z-forward, X-right, Y-down) -->
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <xacro:macro name="tof_sensor" params="name y_reflect">

    <link name="${name}_link">
      <visual>
        <geometry><box size="0.01 0.01 0.01"/></geometry>
        <material name="green"><color rgba="0 1 0 0.8"/></material>
      </visual>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_link"/>
      <!--
        y position:  y_reflect * tof_y_offset
                     → left= +0.08 m,  right= -0.08 m

        yaw (z rotation):  -y_reflect * tof_toe_in_rad
          left  (y_reflect= 1): yaw= -0.197 rad  (rotates ray inward / rightward)
          right (y_reflect=-1): yaw= +0.197 rad  (rotates ray inward / leftward)
      -->
      <origin
        xyz="${tof_x_offset} ${y_reflect * tof_y_offset} ${tof_z_offset}"
        rpy="0.0 0.0 ${-y_reflect * tof_toe_in_rad}"/>
    </joint>

  </xacro:macro>


  <!-- ═══════════════════════════════════════════════════════════════
       Instantiate both sensors
       frame_ids published by imu_tof_node.py must match *_link names:
         tof_left_frame_id  → "tof_left_link"
         tof_right_frame_id → "tof_right_link"
  ════════════════════════════════════════════════════════════════════ -->
  <xacro:tof_sensor name="tof_left"  y_reflect=" 1"/>
  <xacro:tof_sensor name="tof_right" y_reflect="-1"/>

  <!-- ═══════════════════════════════════════════════════════════════
       ToF RIGHT  —  VL53L0X on TCA9548A CH6
       Mirror of left sensor, toed inward symmetrically.
  ════════════════════════════════════════════════════════════════════ -->
  <!-- ================================================================ -->
  <!--  ros2_control hardware interface block                             -->
  <!-- ================================================================ -->
  <ros2_control name="esp32_hardware" type="system">
    <hardware>
      <plugin>esp32_hardware/Esp32HardwareInterface</plugin>
      <param name="serial_port">/dev/ESP32_hub.3</param>
      <param name="baud_rate">921600</param>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-9.0</param>
        <param name="max"> 9.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-9.0</param>
        <param name="max"> 9.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>