<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateExhibitionRecovery">
      
      <PipelineSequence name="NavigateExhibition">
        <RateController hz="1.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        </RateController>
        <ReactiveFallback name="FollowPathFallback">
          <GoalUpdated/>
          <FollowPath path="{path}" controller_id="FollowPath"/>
        </ReactiveFallback>
      </PipelineSequence>

      <Fallback name="GlobalRecoveryEscalation">
        <GoalUpdated/> <RecoveryNode number_of_retries="6" name="CostmapRecovery">
          <AlwaysFailure/> <Sequence name="ClearCostmapsSequence">
            <Wait wait_duration="1.5"/>
            <ClearEntireCostmap name="ClearGlobal" service_name="global_costmap/clear_entirely_global_costmap"/>
            <ClearEntireCostmap name="ClearLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
            <Wait wait_duration="0.5"/>
          </Sequence>
        </RecoveryNode>

        <RecoveryNode number_of_retries="2" name="SpinRecovery">
          <AlwaysFailure/>
          <Spin spin_dist="0.785"/> </RecoveryNode>

        <RecoveryNode number_of_retries="1" name="BackupRecovery">
          <AlwaysFailure/>
          <BackUp backup_dist="0.15" backup_speed="0.1"/>
        </RecoveryNode>

      </Fallback>

    </RecoveryNode>
  </BehaviorTree>
</root>