<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateExhibition">

      <!-- Replan frequently — crowd makes old paths stale fast -->
      <RateController hz="1.0">
        <RecoveryNode number_of_retries="3" name="ComputePathToPose">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
          <ReactiveFallback name="ComputePathToPoseRecoveryFallback">
            <GoalUpdated/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                 service_name="global_costmap/clear_entirely_global_costmap"/>
          </ReactiveFallback>
        </RecoveryNode>
      </RateController>

      <!-- Gentle-first controller recovery loop -->
      <RecoveryNode number_of_retries="8" name="FollowPathWithGentleRecovery">

        <!-- Primary attempt: just follow the path -->
        <ReactiveFallback name="FollowPathFallback">
          <GoalUpdated/>
          <FollowPath path="{path}" controller_id="FollowPath"/>
        </ReactiveFallback>

        <!-- On failure: escalating recovery, each layer rechecks FollowPath
             after every single action so it exits the moment the path clears,
             instead of always burning the full retry budget. -->
        <Fallback name="RecoveryEscalation">

          <!-- Layer 1: wait, retry FollowPath after EACH wait (up to 5x) -->
          <RecoveryNode number_of_retries="5" name="WaitThenRetry">
            <FollowPath path="{path}" controller_id="FollowPath"/>
            <Wait wait_duration="8"/>
          </RecoveryNode>

          <!-- Layer 2: clear costmap + short wait, retry after each (up to 2x).
               Handles stale "ghost" obstacles from people who already left. -->
          <RecoveryNode number_of_retries="2" name="ClearThenRetry">
            <FollowPath path="{path}" controller_id="FollowPath"/>
            <Sequence name="ClearAndWait">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree"
                                   service_name="local_costmap/clear_entirely_local_costmap"/>
              <Wait wait_duration="5"/>
            </Sequence>
          </RecoveryNode>

          <!-- Layer 3: true last resort — minimal, slow backup only.
               No Spin: avoid sweeping the footprint into people standing close. -->
          <RecoveryNode number_of_retries="1" name="BackupThenRetry">
            <FollowPath path="{path}" controller_id="FollowPath"/>
            <Sequence name="BackupAndWait">
              <BackUp backup_dist="0.10" backup_speed="0.02"/>
              <Wait wait_duration="5"/>
            </Sequence>
          </RecoveryNode>

        </Fallback>

      </RecoveryNode>

    </PipelineSequence>
  </BehaviorTree>
</root>