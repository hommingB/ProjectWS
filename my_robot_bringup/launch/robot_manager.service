# /etc/systemd/system/robot_manager.service
#
# Install:
#   sudo cp robot_manager.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable robot_manager
#   sudo systemctl start robot_manager
#
# View logs:
#   journalctl -u robot_manager -f
#
# The service starts after the network and mosquitto broker are up.
# robot_manager.py calls `sudo shutdown -h now` at end of shutdown
# sequence, which needs passwordless sudo for the pi user.
#
# Add to /etc/sudoers (run `sudo visudo`):
#   pi ALL=(ALL) NOPASSWD: /sbin/shutdown
[Unit]
Description=Robot Manager — ROS2 stack + MQTT lifecycle
After=mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=tuanpi5
WorkingDirectory=/home/tuanpi5

ExecStart=/usr/bin/python3 /home/tuanpi5/robot_manager.py

Restart=on-failure
RestartSec=10

TimeoutStopSec=40

StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot_manager

[Install]
WantedBy=multi-user.target